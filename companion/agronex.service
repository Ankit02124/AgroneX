# sudo cp agronex.service /etc/systemd/system/ && sudo systemctl enable --now agronex
[Unit]
Description=AgroneX disease detection and spray control
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/AgroneX/companion
ExecStart=/usr/bin/python3 main.py --config config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
